logs/
*.log
npm-debug.log*

# Sistema operacional e editores
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Claude Code (configurações locais)
.claude/settings.local.json
