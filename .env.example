# Copie para .env:  Copy-Item .env.example .env
# Nunca versione o arquivo .env. Todos os valores abaixo são exemplos seguros.

# development | test | production
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Origens permitidas pelo CORS, separadas por vírgula. Vazio = nenhuma origem externa.
# Em produção, "*" é rejeitado na inicialização.
CORS_ORIGINS=http://localhost:5173

# Documentação interativa em /docs
SWAGGER_ENABLED=true

# De onde vem o IP do cliente (rate limit e auditoria). NUNCA use "true" (é recusado):
#   false            → IP da conexão; X-Forwarded-For ignorado (desenvolvimento, API exposta direto)
#   1                → atrás de UM proxy reverso (nginx, Caddy, load balancer)
#   10.0.0.0/8,...   → confia só nesses proxies (IPs/CIDRs)
TRUST_PROXY=false

# PostgreSQL do docker-compose (porta 5433 no host). Credenciais apenas de desenvolvimento.
DATABASE_URL=postgresql://authapi:authapi_dev_password@127.0.0.1:5433/authapi
# Banco usado pelos testes de integração (criado automaticamente pelo docker-compose).
DATABASE_URL_TEST=postgresql://authapi:authapi_dev_password@127.0.0.1:5433/authapi_test

REDIS_URL=redis://127.0.0.1:6379

# Senha dos usuários FICTÍCIOS criados por `npm run db:seed` (somente desenvolvimento).
# O seed se recusa a rodar com NODE_ENV=production ou contra um banco que não seja local.
SEED_USER_PASSWORD=Demo-Only-Passw0rd!

# --- Autenticação (Etapa 4) ---
# Segredo do access token (HS256). OBRIGATÓRIO, mínimo de 32 caracteres. Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Nunca reutilize o segredo entre ambientes nem o versione. Trocá-lo invalida todos os access tokens.
JWT_ACCESS_SECRET=
# Validade do access token em segundos (padrão 15 minutos).
JWT_ACCESS_TTL_SECONDS=900
# Validade de cada refresh token; a rotação emite um novo, sem passar da validade da sessão.
REFRESH_TOKEN_TTL_DAYS=7
# Validade ABSOLUTA da sessão: depois disso é preciso fazer login de novo.
SESSION_ABSOLUTE_TTL_DAYS=30
# Reapresentar um refresh token já rotacionado dentro desta janela gera 409 sem revogar a sessão.
# 0 = estrito (toda reutilização revoga). Ver docs/architecture.md.
REFRESH_REUSE_GRACE_SECONDS=10

# --- Rate limiting (Etapa 6) ---
# Chave do HMAC-SHA256 que pseudonimiza IPs, emails e ids nas chaves do Redis. OBRIGATÓRIO,
# mínimo de 32 caracteres, DIFERENTE de JWT_ACCESS_SECRET e ESTÁVEL (trocar zera os contadores).
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
RATE_LIMIT_HMAC_SECRET=
# Namespace das chaves no Redis.
RATE_LIMIT_KEY_PREFIX=authapi:rl
# Políticas no formato <máximo>/<janela> (janela em s, m ou h, até 24h). Defaults de
# desenvolvimento: ajuste com base em métricas reais de uso antes de ir para produção.
RATE_LIMIT_LOGIN_IP=5/15m
RATE_LIMIT_LOGIN_ACCOUNT=10/1h
RATE_LIMIT_REGISTER_IP=5/1h
RATE_LIMIT_REFRESH_IP=20/15m
RATE_LIMIT_LOGOUT_USER=20/15m
RATE_LIMIT_LOGOUT_ALL_USER=5/15m
RATE_LIMIT_UPDATE_PROFILE_USER=10/15m
RATE_LIMIT_ADMIN_USERS=60/1m
RATE_LIMIT_ADMIN_USER_BY_ID=60/1m
RATE_LIMIT_ADMIN_AUDIT_EVENTS=30/1m
RATE_LIMIT_FORGOT_PASSWORD_IP=5/1h
RATE_LIMIT_FORGOT_PASSWORD_ACCOUNT=3/1h
RATE_LIMIT_RESET_PASSWORD_IP=10/15m

# --- Recuperação de senha e email (Etapa 7) ---
# Validade do link de recuperação, em minutos (5 a 60). Uso único.
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
# Página do front-end que recebe o token no FRAGMENTO: <url>#token=...
# Em produção é obrigatório usar https.
PASSWORD_RESET_URL=http://localhost:5173/reset-password
# log         → registra só metadados (tipo e validade). NÃO entrega o email. Padrão.
# dev-mailbox → grava a mensagem completa (com o link) em DEV_MAILBOX_DIR. Só desenvolvimento:
#               recusado com NODE_ENV=production. A pasta está no .gitignore.
MAIL_PROVIDER=log
MAIL_FROM=AuthAPI Pro <no-reply@authapi.localhost>
DEV_MAILBOX_DIR=.dev-mailbox

# --- Retenção da auditoria (Etapa 8) ---
# A rotina é MANUAL (npm run audit:retention); não há agendador. Sem --execute, só simula.
# Apagar exige AUDIT_RETENTION_ENABLED=true + --execute + --confirm <nome do banco>.
# Fora de produção, a exclusão só roda em bancos *_test (o banco de desenvolvimento é preservado).
AUDIT_RETENTION_ENABLED=false
# Eventos comuns (login, logout, pedidos de recuperação...): dias.
AUDIT_RETENTION_DAYS=180
# Sinais de ataque e responsabilização (reuso de token, acesso negado, rate limit, leituras e
# alterações administrativas/de perfil, reset concluído): dias. Precisa ser >= AUDIT_RETENTION_DAYS.
AUDIT_RETENTION_EXTENDED_DAYS=365
# Exclusão em lotes curtos (uma transação por lote) e teto de lotes por execução.
AUDIT_RETENTION_BATCH_SIZE=1000
AUDIT_RETENTION_MAX_BATCHES=100

# --- Motor de alertas de segurança (Etapa 9) ---
# Rodadas periódicas dentro da API, a partir de um checkpoint no PostgreSQL. Também há o
# comando manual `npm run alerts:process` (seguro junto com a API: só um processa por vez).
ALERTS_ENGINE_ENABLED=true
ALERTS_ENGINE_INTERVAL_SECONDS=60
# Eventos mais novos que isto esperam a próxima rodada (folga para INSERTs em andamento).
ALERTS_ENGINE_LAG_SECONDS=5
# Na primeira execução (sem checkpoint), quanto da trilha avaliar para trás.
ALERTS_ENGINE_INITIAL_LOOKBACK_HOURS=24
# O mesmo incidente (regra + alvo) vira um único alerta dentro de cada período desta duração.
ALERTS_DEDUP_WINDOW_HOURS=24
# Regras: <limite>/<janela> (s, m ou h, até 24h). Ajuste com base em métricas reais.
ALERT_BRUTE_FORCE_ACCOUNT=8/1h
ALERT_CREDENTIAL_STUFFING=5/1h
ALERT_TOKEN_REUSE=1/24h
ALERT_RATE_LIMIT_ABUSE=3/1h
ALERT_ADMIN_ACCESS_PROBING=5/1h
ALERT_PASSWORD_RESET_ABUSE=5/1h
RATE_LIMIT_ADMIN_SECURITY_ALERTS=60/1m
RATE_LIMIT_ADMIN_SECURITY_ALERT_BY_ID=60/1m
RATE_LIMIT_ADMIN_SECURITY_ALERT_EXPLAIN=10/1m

# --- IA local opcional (só EXPLICA alertas; nunca detecta, decide ou age) ---
# Desligada por padrão. Requer Ollama rodando localmente com o modelo já baixado
# (ex.: `ollama pull qwen2.5:7b`, feito por você; a API nunca baixa modelos).
ALERTS_AI_ENABLED=false
# Só endereços locais são aceitos (localhost, 127.0.0.1, ::1): as evidências não saem da máquina.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# A primeira chamada pode carregar o modelo na memória (dezenas de segundos); depois, ~2 s.
OLLAMA_TIMEOUT_MS=20000
