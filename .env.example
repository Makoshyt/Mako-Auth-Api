# Copie para .env:  Copy-Item .env.example .env
# Nunca versione o arquivo .env. Todos os valores abaixo são exemplos seguros.

# development | test | production
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Origens permitidas pelo CORS, separadas por vírgula. Vazio = nenhuma origem externa.
# Em produção, "*" é rejeitado na inicialização.
CORS_ORIGINS=http://localhost:5173

# Documentação interativa em /docs
SWAGGER_ENABLED=true

# Ative somente atrás de um proxy reverso confiável (afeta o IP usado no rate limit)
TRUST_PROXY=false

# PostgreSQL do docker-compose (porta 5433 no host). Credenciais apenas de desenvolvimento.
DATABASE_URL=postgresql://authapi:authapi_dev_password@127.0.0.1:5433/authapi
# Banco usado pelos testes de integração (criado automaticamente pelo docker-compose).
DATABASE_URL_TEST=postgresql://authapi:authapi_dev_password@127.0.0.1:5433/authapi_test

REDIS_URL=redis://127.0.0.1:6379

# Senha dos usuários FICTÍCIOS criados por `npm run db:seed` (somente desenvolvimento).
# O seed se recusa a rodar com NODE_ENV=production ou contra um banco que não seja local.
SEED_USER_PASSWORD=Demo-Only-Passw0rd!

# --- Autenticação (Etapa 4) ---
# Segredo do access token (HS256). OBRIGATÓRIO, mínimo de 32 caracteres. Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Nunca reutilize o segredo entre ambientes nem o versione. Trocá-lo invalida todos os access tokens.
JWT_ACCESS_SECRET=
# Validade do access token em segundos (padrão 15 minutos).
JWT_ACCESS_TTL_SECONDS=900
# Validade de cada refresh token; a rotação emite um novo, sem passar da validade da sessão.
REFRESH_TOKEN_TTL_DAYS=7
# Validade ABSOLUTA da sessão: depois disso é preciso fazer login de novo.
SESSION_ABSOLUTE_TTL_DAYS=30
# Reapresentar um refresh token já rotacionado dentro desta janela gera 409 sem revogar a sessão.
# 0 = estrito (toda reutilização revoga). Ver docs/architecture.md.
REFRESH_REUSE_GRACE_SECONDS=10
