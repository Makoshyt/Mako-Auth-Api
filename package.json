{
  "name": "authapi-pro",
  "version": "0.1.0",
  "description": "API REST de autenticação e gerenciamento de usuários com Fastify, TypeScript, PostgreSQL e Prisma.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate",
    "docker:up": "docker compose up -d --wait",
    "docker:stop": "docker compose stop",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "audit:retention": "tsx scripts/audit-retention.ts",
    "alerts:process": "tsx scripts/alerts-process.ts",
    "alerts:retention": "tsx scripts/alerts-retention.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "jose": "6.2.14",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "openapi-types": "12.1.3",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  }
}
